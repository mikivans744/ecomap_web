rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.estadoActivo == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveUser(userId) {
      return existsAfter(/databases/$(database)/documents/users/$(userId)) &&
        getAfter(/databases/$(database)/documents/users/$(userId)).data.estadoActivo == true;
    }

    function canUpdateOwnProfile(userId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(userId) &&
        changedKeys.hasOnly(['nombre', 'foto', 'telefono', 'direccion', 'zona']) &&
        !changedKeys.hasAny([
          'reputacion',
          'materialReciclado',
          'totalReciclado',
          'rol',
          'estadoActivo'
        ]);
    }

    function isPublicationSoldByCompletedOffer(publicationId) {
      let offerId = request.resource.data.soldByOfferId;
      return request.resource.data.estado == 'vendido' &&
        offerId is string &&
        existsAfter(/databases/$(database)/documents/ofertas/$(offerId)) &&
        getAfter(/databases/$(database)/documents/ofertas/$(offerId)).data.estado == 'finalizada' &&
        getAfter(/databases/$(database)/documents/ofertas/$(offerId)).data.publicacionId == publicationId;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isAdmin() || canUpdateOwnProfile(userId);
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /publicaciones/{publicationId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isActiveUser(request.auth.uid) &&
        request.resource.data.estado != 'vendido';
      allow update: if isAdmin() &&
          resource.data.estado != 'vendido' &&
          (request.resource.data.estado != 'vendido' ||
            isPublicationSoldByCompletedOffer(publicationId)) ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
          resource.data.estado != 'vendido' &&
          isActiveUser(request.auth.uid) &&
          request.resource.data.estado != 'vendido');
      allow delete: if false;
    }

    match /recolectores/{recolectorId} {
      allow read, write: if isAdmin();
    }

    match /recolector_plate_registry/{plateId} {
      allow read, write: if isAdmin();
    }

    match /centros_acopio/{centroId} {
      allow read, write: if isAdmin();
    }

    match /ofertas/{ofertaId} {
      allow read, write: if isAdmin();
    }

    match /oferta_active_locks/{lockId} {
      allow read, write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /sync/{syncId} {
      allow read, write: if isAdmin();
    }

    match /sync_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /devices/{deviceId} {
      allow read, write: if isSignedIn();
    }

    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
